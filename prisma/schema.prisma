// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model AnswerChoiceSnapshot {
  id           Int                @id @default(autoincrement())
  reviewId     Int
  review       ProductReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  questionId   Int
  question     ReviewFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label        String
  value        String
  display      Boolean
  snapshotDate DateTime           @default(now())
}

model RadioAnswerChoice {
  id         Int                @id @default(autoincrement())
  value      String
  label      String
  display    Boolean
  questionId Int
  question   ReviewFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TextAnswer {
  id         Int                @id @default(autoincrement())
  value      String
  questionId Int
  question   ReviewFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id                    Int                    @id @default(autoincrement())
  store                 String
  productId             String
  title                 String
  body                  String
  name                  String
  email                 String?
  rating                Int
  media                 ProductReviewMedia[]
  date                  DateTime
  isPublished           Boolean
  customQuestionAnswers AnswerChoiceSnapshot[]
}

model ProductReviewMedia {
  id       Int           @id @default(autoincrement())
  url      String
  name     String
  reviewId Int
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewFormQuestion {
  id                        Int                    @id @default(autoincrement())
  store                     String
  productConfiguration      String[]
  answerType                String[]
  productIds                String[]
  collectionIds             String[]
  title                     String
  isRequired                String[]
  radioAnswerChoices        RadioAnswerChoice[]
  AnswerChoiceSnapshot      AnswerChoiceSnapshot[]
  textAnswers               TextAnswer[]
  radioAllowMultipleAnswers String[]
  radioDisplayAnswer        String[]
  radioDisplayedAnswerLabel String
}

model SavedReviewsTableViews {
  id                 Int      @id @default(autoincrement())
  store              String
  name               String
  queryValue         String
  sortSelected       String[]
  selectedProducts   String[]
  selectedRatings    String[]
  selectedVisibility String[]
}

model SavedCustomQuestionTableView {
  id                           Int      @id @default(autoincrement())
  store                        String
  name                         String
  queryValue                   String
  sortSelected                 String[]
  selectedProductConfiguration String[]
}

model SavedReviewRequestTableView {
  id                          Int      @id @default(autoincrement())
  store                       String
  name                        String
  queryValue                  String
  selectedProductFilters      String[]
  selectedFulfillmentFilters  String[]
  selectedReviewStatusFilters String[]
  sortSelected                String[]
}

model AppSettings {
  id                  Int      @id @default(autoincrement())
  store               String
  autoPublishReviews  String[]
  minReviewRating     Int
  firstReviewRequest  Int
  secondReviewRequest Int
}

model ReviewRequestEmailLogo {
  id                           Int                        @id @default(autoincrement())
  url                          String
  name                         String
  reviewRequestEmailSettingsId Int                        @unique
  reviewRequestEmailSettings   ReviewRequestEmailSettings @relation(fields: [reviewRequestEmailSettingsId], references: [id], onDelete: Cascade)
}

model ReviewRequestEmailSettings {
  id             Int                     @id @default(autoincrement())
  store          String
  bannerBgColor  String
  logo           ReviewRequestEmailLogo?
  productDisplay String[]
  productIds     String[]
}

model ReviewFormSettings {
  id                  Int    @id @default(autoincrement())
  store               String
  heading             String
  subheading          String
  headlinePlaceholder String
  reviewPlaceholder   String
  primaryFormColor    String
}

model ReviewRequest {
  id                Int       @id @default(autoincrement())
  store             String
  createdAt         DateTime
  orderName         String
  orderId           BigInt
  name              String
  email             String
  fulfillmentStatus String?
  reviewStatus      String    @default("waiting")
  requestSentDate   DateTime?
  emailsSent        Int       @default(0)
}

model EligibleProduct {
  id         Int      @id @default(autoincrement())
  productId  String
  variantIds String[]
  rewardId   Int
  reward     Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

model Reward {
  id                      Int               @id @default(autoincrement())
  limitedEligibleProducts EligibleProduct[]
  store                   String

  subparId  Int @unique
  goodId    Int @unique
  perfectId Int @unique

  subpar  RewardSetting @relation("SubparReward", fields: [subparId], references: [id], onDelete: Cascade)
  good    RewardSetting @relation("GoodReward", fields: [goodId], references: [id], onDelete: Cascade)
  perfect RewardSetting @relation("PerfectReward", fields: [perfectId], references: [id], onDelete: Cascade)
}

model RewardSetting {
  id                       Int    @id @default(autoincrement())
  selectedRewardType       String
  fixedAmount              Int
  percentageAmount         Int
  bogoRewardType           String
  bogoPurchaseAmount       Int
  bogoReceiveAmount        Int
  bogoDiscountAmount       Int
  minPurchaseType          String
  minPurchaseDollarValue   Int
  minPurchaseQuantityValue Int

  subparReward  Reward? @relation("SubparReward")
  goodReward    Reward? @relation("GoodReward")
  perfectReward Reward? @relation("PerfectReward")
}

model CurrentOrdersStatus {
  id      Int     @id @default(autoincrement())
  store   String
  handled Boolean @default(false)
}
