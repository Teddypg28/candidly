// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model CustomQuestionAnswer {
  id       Int           @id @default(autoincrement())
  value    String
  label    String
  display  Boolean
  reviewId Int
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id                    Int                    @id @default(autoincrement())
  store                 String
  productId             BigInt
  title                 String
  body                  String
  name                  String
  email                 String?
  rating                Int
  media                 String
  date                  DateTime
  customQuestionAnswers CustomQuestionAnswer[]
  isPublished           Boolean
}

model ReviewFormQuestion {
  id                   Int                      @id @default(autoincrement())
  store                String
  productId            BigInt
  title                String
  label                String?
  answerLabel          String?
  displayAnswer        Boolean
  answerChoices        ReviewFormAnswerChoice[]
  allowMultipleAnswers Boolean
  isRequired           Boolean
}

model ReviewFormAnswerChoice {
  id         Int                @id @default(autoincrement())
  questionId Int
  question   ReviewFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  title      String
}

model SavedReviewsTableViews {
  id               Int     @id @default(autoincrement())
  store            String
  name             String
  queryValue       String
  sortSelected     String
  selectedProducts String?
  selectedRatings  String?
}

model SavedCustomQuestionsTableView {
  id                    Int     @id @default(autoincrement())
  store                 String
  name                  String
  queryValue            String
  sortSelected          String
  selectedProducts      String?
  selectedQuestionTypes String?
}

model AppSettings {
  id                  Int      @id @default(autoincrement())
  store               String
  autoPublishReviews  String[]
  minReviewRating     Int
  firstReviewRequest  Int
  secondReviewRequest Int
}

model ReviewFormSettings {
  id                  Int    @id @default(autoincrement())
  store               String
  heading             String
  subheading          String
  headlinePlaceholder String
  reviewPlaceholder   String
  primaryFormColor    String
}

model ReviewRequest {
  id                Int       @id @default(autoincrement())
  date              DateTime
  orderName         String
  orderId           BigInt
  store             String
  email             String
  fulfillmentStatus String?
  reviewStatus      String    @default("waiting")
  requestDate       DateTime?
  emailsSent        Int       @default(0)
}

model CurrentOrdersStatus {
  id      Int     @id @default(autoincrement())
  store   String
  handled Boolean @default(false)
}

model SavedReviewRequestTableView {
  id                          Int      @id @default(autoincrement())
  store                       String
  name                        String
  queryValue                  String
  selectedProductFilters      String[]
  selectedFulfillmentFilters  String[]
  selectedReviewStatusFilters String[]
  sortSelected                String[]
}
