// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                   String   @id @default(uuid())
  store                String
  autoPublishReviews   String[] @default(["false"])
  minReviewRating      Int      @default(5)
  isReviewFormDisabled String   @default("false")
  firstReviewRequest   Int      @default(10)
  secondReviewRequest  Int      @default(5)
  primaryEmail         String
  companyName          String
  domain               String   @default("")
}

model AnswerChoiceSnapshot {
  id           Int                @id @default(autoincrement())
  reviewId     String
  review       ProductReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  questionId   String
  question     ReviewFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label        String
  value        String
  display      Boolean
  snapshotDate DateTime           @default(now())
}

model CurrentOrdersStatus {
  id      String  @id @default(uuid())
  store   String
  handled Boolean @default(false)
}

model CustomerQuestion {
  id        String                  @id @default(uuid())
  createdAt DateTime                @default(now())
  productId String
  title     String
  firstName String
  email     String
  store     String
  answer    CustomerQuestionAnswer?
  emailSent Boolean                 @default(false)
}

model CustomerQuestionAnswer {
  id         String           @id @default(uuid())
  body       String
  store      String
  questionId String           @unique
  question   CustomerQuestion @relation(fields: [questionId], references: [id])
}

model CustomerQuestionEmailSettings {
  id      String @id @default(uuid())
  store   String
  subject String
  body    String
}

model CustomerRewardEmailSettings {
  id      String @id @default(uuid())
  store   String
  subject String
  body    String
}

model EmailDesignSettings {
  id            String                  @id @default(uuid())
  store         String
  bannerBgColor String                  @default("#FFFFFF")
  logo          ReviewRequestEmailLogo?
}

model EligibleProduct {
  id              String        @id @default(uuid())
  productId       String
  rewardSettingId String
  reward          RewardSetting @relation(fields: [rewardSettingId], references: [id], onDelete: Cascade)
}

model EligibleCollection {
  id              String        @id @default(uuid())
  collectionId    String
  rewardSettingId String
  reward          RewardSetting @relation(fields: [rewardSettingId], references: [id], onDelete: Cascade)
}

model OnboardingDismissalState {
  id          String  @id @default(uuid())
  store       String
  isDismissed Boolean @default(false)
}

model ProductReview {
  id                     String                 @id @default(uuid())
  store                  String
  productId              String
  title                  String
  body                   String
  firstName              String
  email                  String
  rating                 Int
  characterEditsLeft     Int                    @default(30)
  media                  ProductReviewMedia[]
  date                   DateTime               @default(now())
  isPublished            Boolean
  reviewRequestId        String?
  radioQuestionResponses AnswerChoiceSnapshot[]
  textQuestionResponses  TextAnswer[]
  pendingRewardId        String?                @unique
  pendingReward          PendingReward?         @relation(fields: [pendingRewardId], references: [id], onDelete: Cascade)
}

model ProductReviewMedia {
  id       String        @id @default(uuid())
  url      String
  name     String
  reviewId String
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewFormQuestion {
  id                        String                 @id @default(uuid())
  store                     String
  productConfiguration      String[]
  answerType                String[]
  productIds                String[]
  collectionIds             String[]
  title                     String
  isRequired                String[]
  radioAnswerChoices        RadioAnswerChoice[]
  answerChoiceSnapshots     AnswerChoiceSnapshot[]
  textAnswers               TextAnswer[]
  radioAllowMultipleAnswers String[]
  radioDisplayAnswer        String[]
  radioDisplayedAnswerLabel String
  published                 Boolean                @default(true)
}

model RadioAnswerChoice {
  id         String             @id @default(uuid())
  value      String
  label      String
  display    Boolean
  questionId String
  question   ReviewFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ReviewRequestEmailLogo {
  id                    Int                 @id @default(autoincrement())
  url                   String
  name                  String
  emailDesignSettingsId String              @unique
  emailDesignSettings   EmailDesignSettings @relation(fields: [emailDesignSettingsId], references: [id], onDelete: Cascade)
}

model ReviewRequestEmailSettings {
  id                   String @id @default(uuid())
  store                String
  initialEmailBody     String
  followUpEmailBody    String
  initialEmailSubject  String
  followUpEmailSubject String
}

model ReviewFormSettings {
  id                     String @id @default(uuid())
  store                  String
  starRatingHeading      String @default("How many stars would you give it?")
  titleHeading           String @default("Give your review a title")
  titlePlaceholder       String @default("Sum up your review in a few words")
  bodyHeading            String @default("What did your like or not like?")
  bodyPlaceholder        String @default("What would you tell your friends?")
  customQuestionsHeading String @default("We are interested to know...")
  mediaHeading           String @default("Want to add an image or video?")
}

model ReviewRequest {
  id                String   @id @default(uuid())
  store             String
  createdAt         DateTime
  orderName         String
  orderId           BigInt
  firstName         String
  email             String
  fulfillmentStatus String?
  isComplete        Boolean  @default(false)
  nextRequestDate   String?
  emailsSent        Int      @default(0)
  authToken         String
}

model RewardSettings {
  id    String @id @default(uuid())
  store String
  type  String
}

model Reward {
  id    String @id @default(uuid())
  store String

  type String

  subparId  String @unique
  goodId    String @unique
  perfectId String @unique
  mediaId   String @unique

  subpar  RewardSetting @relation("SubparReward", fields: [subparId], references: [id])
  good    RewardSetting @relation("GoodReward", fields: [goodId], references: [id])
  perfect RewardSetting @relation("PerfectReward", fields: [perfectId], references: [id])
  media   RewardSetting @relation("MediaReward", fields: [mediaId], references: [id])
}

model RewardSetting {
  id                             String               @id @default(uuid())
  selectedRewardType             String
  dollarAmount                   Int
  percentageAmount               Float
  bxgyRewardType                 String
  bxgyPurchaseAmount             Int
  bxgyReceiveAmount              Int
  bxgyPercentageAmount           Float
  bxgyDollarAmount               Int
  bxgyPurchaseProductId          String
  bxgyReceiveProductId           String
  minPurchaseType                String
  minPurchaseDollarValue         Int
  minPurchaseQuantityValue       Int
  productCollectionConfiguration String               @default("all")
  eligibleProducts               EligibleProduct[]
  eligibleCollections            EligibleCollection[]

  subparReward  Reward? @relation("SubparReward")
  goodReward    Reward? @relation("GoodReward")
  perfectReward Reward? @relation("PerfectReward")
  mediaReward   Reward? @relation("MediaReward")
}

model PendingReward {
  id           String         @id @default(uuid())
  store        String
  autoSendDate DateTime
  discountId   String
  title        String
  code         String
  firstName    String
  toAddress    String
  sent         Boolean        @default(false)
  review       ProductReview?
}

model Subscription {
  id             String @id @default(uuid())
  shop           String
  type           String @default("free")
  emailsSent     Int    @default(0)
  emailQuota     Int
  planStarted    String @default("")
  renewalDate    String @default("")
  subscriptionId String @default("")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model SavedReviewsTableViews {
  id                 String   @id @default(uuid())
  store              String
  name               String
  queryValue         String
  sortSelected       String[]
  selectedProducts   String[]
  selectedRatings    String[]
  selectedVisibility String[]
}

model SavedQuestionAnswerTableView {
  id                   String   @id @default(uuid())
  store                String
  name                 String
  queryValue           String
  sortSelected         String[]
  selectedProducts     String[]
  selectedAnswerStatus String[]
}

model SavedCustomQuestionTableView {
  id                           String   @id @default(uuid())
  store                        String
  name                         String
  queryValue                   String
  sortSelected                 String[]
  selectedProductConfiguration String[]
}

model SavedReviewRequestTableView {
  id                          String   @id @default(uuid())
  store                       String
  name                        String
  queryValue                  String
  selectedProductFilters      String[]
  selectedFulfillmentFilters  String[]
  selectedReviewStatusFilters String[]
  sortSelected                String[]
}

model TextAnswer {
  id         String             @id @default(uuid())
  value      String
  reviewId   String
  review     ProductReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  questionId String
  question   ReviewFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
