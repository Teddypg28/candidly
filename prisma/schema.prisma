// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model CustomQuestionAnswer {
  id       Int           @id @default(autoincrement())
  value    String
  label    String
  display  Boolean
  reviewId Int
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id                    Int                    @id @default(autoincrement())
  store                 String
  productId             BigInt
  title                 String
  body                  String
  name                  String
  email                 String?
  rating                Int
  media                 String
  date                  DateTime
  customQuestionAnswers CustomQuestionAnswer[]
  isPublished           Boolean
}

model ReviewFormQuestion {
  id                        Int      @id @default(autoincrement())
  store                     String
  productConfiguration      String[]
  answerType                String[]
  productIds                String[]
  collectionIds             String[]
  title                     String
  isRequired                String[]
  radioAnswerChoices        String[]
  radioAllowMultipleAnswers String[]
  radioDisplayAnswer        String[]
  radioDisplayedAnswerLabel String?
}

model SavedReviewsTableViews {
  id               Int     @id @default(autoincrement())
  store            String
  name             String
  queryValue       String
  sortSelected     String
  selectedProducts String?
  selectedRatings  String?
}

model SavedCustomQuestionsTableView {
  id                    Int     @id @default(autoincrement())
  store                 String
  name                  String
  queryValue            String
  sortSelected          String
  selectedProducts      String?
  selectedQuestionTypes String?
}

model SavedReviewRequestTableView {
  id                          Int      @id @default(autoincrement())
  store                       String
  name                        String
  queryValue                  String
  selectedProductFilters      String[]
  selectedFulfillmentFilters  String[]
  selectedReviewStatusFilters String[]
  sortSelected                String[]
}

model AppSettings {
  id                               Int              @id @default(autoincrement())
  store                            String
  autoPublishReviews               String[]
  reviewRequestEmailProductDisplay String[]
  displayProducts                  DisplayProduct[]
  minReviewRating                  Int
  firstReviewRequest               Int
  secondReviewRequest              Int
}

model ReviewFormSettings {
  id                  Int    @id @default(autoincrement())
  store               String
  heading             String
  subheading          String
  headlinePlaceholder String
  reviewPlaceholder   String
  primaryFormColor    String
}

model DisplayProduct {
  id            Int         @id @default(autoincrement())
  store         String
  productId     String
  title         String
  imageUrl      String?
  appSettingsId Int
  appSettings   AppSettings @relation(fields: [appSettingsId], references: [id], onDelete: Cascade)
}

model ReviewRequest {
  id                Int       @id @default(autoincrement())
  store             String
  orderName         String
  orderId           BigInt
  name              String
  email             String
  fulfillmentStatus String?
  reviewStatus      String    @default("waiting")
  requestSentDate   DateTime?
  emailsSent        Int       @default(0)
}

model EligibleProduct {
  id         Int      @id @default(autoincrement())
  productId  String
  variantIds String[]
  rewardId   Int
  reward     Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

model Reward {
  id                      Int               @id @default(autoincrement())
  limitedEligibleProducts EligibleProduct[]
  store                   String

  subparId  Int @unique
  goodId    Int @unique
  perfectId Int @unique

  subpar  RewardSetting @relation("SubparReward", fields: [subparId], references: [id], onDelete: Cascade)
  good    RewardSetting @relation("GoodReward", fields: [goodId], references: [id], onDelete: Cascade)
  perfect RewardSetting @relation("PerfectReward", fields: [perfectId], references: [id], onDelete: Cascade)
}

model RewardSetting {
  id                       Int    @id @default(autoincrement())
  selectedRewardType       String
  fixedAmount              Int
  percentageAmount         Int
  bogoRewardType           String
  bogoPurchaseAmount       Int
  bogoReceiveAmount        Int
  bogoDiscountAmount       Int
  minPurchaseType          String
  minPurchaseDollarValue   Int
  minPurchaseQuantityValue Int

  subparReward  Reward? @relation("SubparReward")
  goodReward    Reward? @relation("GoodReward")
  perfectReward Reward? @relation("PerfectReward")
}

model CurrentOrdersStatus {
  id      Int     @id @default(autoincrement())
  store   String
  handled Boolean @default(false)
}
