<link rel='stylesheet' href="{{'reviews.css' | asset_url }}" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

{% assign product = block.settings.product %}
{% assign avg_rating = block.settings.product.metafields.reviews.rating.value %}
{% assign rating_count = block.settings.product.metafields.reviews.rating_count.value %}

<script src="{{ 'activateUploadMediaContainer.js' | asset_url }}" defer></script>
<script src="{{ 'renderCustomerQuestionForm.js' | asset_url }}" defer></script>
<script src="{{ 'renderCustomQuestions.js' | asset_url }}" defer></script>
<script src="{{ 'renderReviewForm.js' | asset_url }}" defer></script>
<script src="{{ 'createReviewStars.js' | asset_url }}" defer></script>
<script src="{{ 'reviewFormFunctions.js' | asset_url }}" defer></script>
<script src="{{ 'renderQuestions.js' | asset_url }}" defer></script>
<script src="{{ 'reviewWidgetFunctions.js' | asset_url }}" defer></script>
<script src="{{ 'paginatorFunctions.js' | asset_url }}" defer></script>

<html>
    <div class='mainReviewContainer'></div>
</html>

<script>

    // configures product rich snippet
    const richSnippetScriptTag = document.createElement('script')
    richSnippetScriptTag.type = "application/ld+json"
    richSnippetScriptTag.textContent = `
        {
            "@context": "https://schema.org/",
            "@type": "Product",
            "name": '{{product.title}}',
            "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": '{{avg_rating}}',
                "reviewCount": '{{rating_count}}'
            }
        }
    `
    document.querySelector('head').appendChild(richSnippetScriptTag)

    const customQuestions = []

    const productTitle = '{{product.title}}'
    const productImage = '{{ product.featured_image | image_url: '400x' }}'

    let isReviewFormDisabled
    let companyName = ""
    let questionsWithAnswers = []
    let reviewData = {}
    const avgRating = parseFloat('{{avg_rating}}')
    const reviewProductId = '{{product.id}}';

    (async function fetchReviewQuestionData() {

        // See whether or not they want to allow anyone to fill out reviews
        const reviewFormDisabledRes = await fetch(`https://${window.Shopify.shop}/apps/api/settings`)
        const isReviewFormDisabledData = await reviewFormDisabledRes.json()
        isReviewFormDisabled = isReviewFormDisabledData.disabled
      
        // Fetch custom questions attached to product ID
        const questionsRes = await fetch(`https://${window.Shopify.shop}/apps/api/questions/${reviewProductId}`);
        const questionsData = await questionsRes.json();

        if (questionsData.result.length > 0) {
            questionsData.result.forEach(question => customQuestions.push(question));
            customQuestions.sort((a, b) => a.radioAnswerChoices.length - b.radioAnswerChoices.length);
        }

        // Fetch Q&A
        const qaRes = await fetch(`https://${window.Shopify.shop}/apps/api/q&a/${reviewProductId}`)
        const qaData = await qaRes.json();

        if (!qaData.error) {
            questionsWithAnswers = qaData.questions;
            companyName = qaData.companyName;
        }

        // Fetch reviews
        const reviewsRes = await fetch(`https://${window.Shopify.shop}/apps/api/reviews/${reviewProductId}?page=1&limit=5`);
        const reviewJson = await reviewsRes.json();
        reviewData = reviewJson;

        renderWidgetSkeleton();

        if (reviewData.totalReviews > 0) {
            createReviewStars();
            document.querySelector('.hasReviewsWrapper').classList.remove('hidden');
        }
    })();

</script>

{% schema %}
    {
        "name": "Customer Reviews",
        "target": "section",
        "settings": [
           { "type": "product",
            "id": "product",
            "label": "Product",
            "autofill": true
           }
        ]
    }
{% endschema %}