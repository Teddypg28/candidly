<link rel='stylesheet' href="{{'reviews.css' | asset_url }}" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

{% assign product = block.settings.product %}
{% assign avg_rating = block.settings.product.metafields.reviews.rating.value %}
{% assign rating_count = block.settings.product.metafields.reviews.rating_count.value %}
{% assign shop_name = shop.myshopify_domain %}

{{ 'createReviewStars.js' | asset_url | script_tag }}
{{ 'reviewFormFunctions.js' | asset_url | script_tag }}
{{ 'reviewWidgetFunctions.js' | asset_url | script_tag }}
{{ 'paginatorFunctions.js' | asset_url | script_tag }}

<html>
    <div class='mainReviewContainer'></div>
</html>

<script>

// configures product rich snippet
const richSnippetScriptTag = document.createElement('script')
richSnippetScriptTag.type = "application/ld+json"
richSnippetScriptTag.textContent = `
    {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": '{{product.title}}',
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": '{{avg_rating}}',
            "reviewCount": '{{rating_count}}'
        }
    }
`
document.querySelector('head').appendChild(richSnippetScriptTag)

// initialize review settings
const reviewSettings = {
    formHeading: 'Tell Us What You Think',
    formSubheading: 'Rate it out of 5 stars:',
    primaryColor: 'black',
    backgroundColor: '#f6f6f6',
    customQuestions:[]
}
let reviews = []
let reviewData = {}
const avgRating = parseFloat('{{avg_rating}}')
const reviewProductId = '{{product.id}}'

// fetch custom questions attached to product id
fetch(`https://${window.Shopify.shop}/apps/api/questions/${reviewProductId}`)
.then(data => data.json())
.then(questions => {
    // if there are custom questions, push them to the customQuestions key of the review settings object
    if (questions.result.length > 0) {
        questions.result.forEach(question => {
            reviewSettings.customQuestions.push(question)
        })
        reviewSettings.customQuestions.sort((a, b) => {
            return a.radioAnswerChoices.length - b.radioAnswerChoices.length
        })
    }
})
.then(() => {
    // fetch the settings connected to the store
    fetch(`https://${window.Shopify.shop}/apps/api/settings`)
        .then(data => data.json())
        .then(result => {
            // if there is no error, overwrite the placeholder reviewSettings object that was initialized above with the store's custom settings
            if (!result.error) {
                const { formHeading, formSubheading, primaryColor, backgroundColor } = result
                reviewSettings.formHeading = formHeading
                reviewSettings.formSubheading = formSubheading
                reviewSettings.primaryColor = primaryColor
                reviewSettings.backgroundColor = backgroundColor
            }
            // set background color of the main review container to the color in the review settings
            document.querySelector('.mainReviewContainer').style.backgroundColor = reviewSettings.backgroundColor
        })
        .then(() => {
            // fetch all of the reviews connected to the product id
            fetch(`https://${window.Shopify.shop}/apps/api/reviews/${reviewProductId}?page=1&limit=5`)
                .then(res => res.json())
                .then(data => { 
                    // set the global reviewData object to the returned review data so we can access it below
                    reviewData = data 
                })
        .then(() => {

            renderReviews()
            if (reviewData.reviews.length > 0) {
                createReviewStars(reviewData, reviewSettings, avgRating)
                document.querySelector('.hasReviewsWrapper').classList.remove('hidden')
                document.querySelector('.noReviewsText').classList.add('hidden')
            }   

            // change reviews section background color
            const divs = Array.from(document.querySelectorAll('div'))
            const targetDiv = divs.find(div => div.id.includes('candidly'))
            const section = targetDiv.closest('section')
            section.style.backgroundColor = reviewSettings.backgroundColor
    })
})})

</script>

{% schema %}
    {
        "name": "Customer Reviews",
        "target": "section",
        "settings": [
           { "type": "product",
            "id": "product",
            "label": "Product",
            "autofill": true
           }
        ]
    }
{% endschema %}